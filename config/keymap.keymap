#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        right_click {
            bindings = <&mkp MB2>;
            key-positions = <28 29>;
            layers = <0>;
        };

        left_click {
            bindings = <&mkp MB1>;
            key-positions = <27 28>;
        };

        middle_click {
            bindings = <&mkp MB3>;
            key-positions = <27 28 29>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <46 47>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <47 48>;
        };

        left_click2 {
            bindings = <&mkp MB1>;
            key-positions = <32 33>;
        };

        right_click2 {
            bindings = <&mkp MB2>;
            key-positions = <33 34>;
        };

        middle_click2 {
            bindings = <&mkp MB3>;
            key-positions = <32 33 34>;
        };

        to4 {
            bindings = <&to 4>;
            key-positions = <49 50 64>;
        };
    };

    behaviors {
        LayerTD01: LayerTD01 {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYERTD01";
            #binding-cells = <0>;
            bindings = <&to 0>, <&to 2>;

            tapping-term-ms = <300>;
        };

        LayerTD02: LayerTD02 {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYERTD02";
            #binding-cells = <0>;
            bindings = <&to 1>, <&to 3>;

            tapping-term-ms = <300>;
        };

        HOME_END: HOME_END {
            compatible = "zmk,behavior-tap-dance";
            label = "HOME_END";
            #binding-cells = <0>;
            bindings = <&kp HOME>, <&kp END>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        s_main {
            bindings = <
&none  &none      &none         &none         &none        &none                                     &none                  &none  &none      &none             &none      &none
&none  &kp Q      &kp W         &kp E         &kp R        &kp T                                     &kp Y                  &kp U  &kp I      &kp O             &kp P      &none
&none  &kp A      &kp S         &kp D         &kp F        &kp G        &LayerTD01  &LayerTD02       &kp H                  &kp J  &kp K      &kp L             &kp MINUS  &none
&none  &kp Z      &kp X         &kp C         &kp V        &lt 2 B      &trans      &kp TAB          &lt 2 N                &kp M  &kp COMMA  &kp PERIOD        &kp SLASH  &none
&none  &kp LCTRL  &kp LEFT_GUI  &kp LEFT_ALT  &lt 3 GRAVE  &lt 1 SPACE  &kp ENTER   &kp RIGHT_SHIFT  &lt 1 INTERNATIONAL_4  &none  &none      &kp LEFT_BRACKET  &kp APOS   &none
            >;
        };

        s_num {
            bindings = <
&to 3  &none            &none            &none            &none            &none                          &none             &none                &none                    &none          &none          &none
&none  &kp KP_NUMLOCK   &kp KP_N7        &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp BACKSPACE                  &kp HOME          &kp END              &kp PG_UP                &kp PAGE_DOWN  &kp ESCAPE     &none
&none  &kp KP_PLUS      &kp KP_NUMBER_4  &kp KP_N5        &kp KP_N6        &kp KP_MINUS   &trans  &trans  &kp LEFT          &kp DOWN             &kp UP_ARROW             &kp RIGHT      &kp TAB        &none
&none  &kp KP_MULTIPLY  &kp KP_N1        &kp KP_N2        &kp KP_N3        &kp KP_SLASH   &trans  &trans  &kp SINGLE_QUOTE  &kp INTERNATIONAL_1  &kp LS(INTERNATIONAL_3)  &kp LS(EQUAL)  &kp SEMICOLON  &none
&none  &kp LS(MINUS)    &kp KP_NUMBER_0  &kp KP_DOT       &trans           &trans         &trans  &trans  &trans            &trans               &trans                   &trans         &trans         &none
            >;
        };

        s_sign {
            bindings = <
&none  &none             &none             &none             &none             &none                       &none              &none            &none       &none       &none                &none
&none  &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(N5)                  &kp LS(NUMBER_6)   &kp LS(N7)       &kp LS(N8)  &kp LS(N9)  &kp INTERNATIONAL_1  &none
&none  &trans            &trans            &trans            &trans            &trans      &trans  &trans  &kp RIGHT_BRACKET  &kp NON_US_HASH  &trans      &trans      &trans               &none
&none  &trans            &trans            &trans            &trans            &trans      &trans  &trans  &trans             &trans           &trans      &trans      &trans               &none
&none  &trans            &trans            &trans            &trans            &trans      &trans  &trans  &trans             &trans           &trans      &trans      &trans               &none
            >;
        };

        function {
            bindings = <
&none  &none   &none    &none    &none    &none                   &none              &none            &none       &none   &none   &none
&none  &kp F1  &kp F2   &kp F3   &kp F4   &trans                  &trans             &trans           &trans      &trans  &trans  &none
&none  &kp F5  &kp F6   &kp F7   &kp F8   &trans  &trans  &trans  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp K_MUTE  &trans  &trans  &none
&none  &kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans  &trans  &trans             &trans           &trans      &trans  &trans  &none
&none  &trans  &trans   &trans   &trans   &trans  &trans  &trans  &trans             &trans           &trans      &trans  &trans  &none
            >;
        };

        system {
            bindings = <
&none  &none  &none  &none  &none  &none                &none         &none         &none         &none         &none       &none
&none  &none  &none  &none  &none  &none                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none         &none         &none         &none         &none       &none
&none  &none  &none  &none  &none  &none  &none  &none  &none         &none         &none         &none         &none       &none
&none  &none  &none  &none  &none  &none  &none  &none  &none         &none         &none         &none         &none       &none
            >;
        };
    };
};
